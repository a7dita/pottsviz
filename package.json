{
  "name": "pottsviz",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "node scripts/build-backend.mjs && vite dev",
    "build": "node scripts/build-backend.mjs && vite build && node scripts/bundle-backend.mjs",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --plugin-search-dir . --check . && eslint .",
    "format": "prettier --plugin-search-dir . --write .",
    "build:backend": "node scripts/build-backend.mjs",
    "test": "node scripts/build-backend.mjs && node scripts/test-api.mjs"
  },
  "devDependencies": {
    "@iconify/iconify": "^3.1.1",
    "@iconify/json": "^2.2.109",
    "@sveltejs/adapter-vercel": "^6.3.4",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@types/d3": "^7.4.3",
    "@types/node": "^22.20.5",
    "@typescript-eslint/eslint-plugin": "^5.45.0",
    "@typescript-eslint/parser": "^5.45.0",
    "@unocss/preset-icons": "^0.65.4",
    "eslint": "^8.28.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-svelte": "^2.30.0",
    "katex": "^0.16.8",
    "prettier": "^2.8.0",
    "prettier-plugin-svelte": "^2.10.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "tslib": "^2.4.1",
    "typescript": "^5.0.0",
    "unocss": "^0.65.4",
    "vite": "^6.4.4"
  },
  "type": "module",
  "dependencies": {
    "@unocss/reset": "^0.65.4",
    "d3": "^7.8.5"
  },
  "engines": {
    "node": "22.x"
  },
  "packageManager": "pnpm@11.25.0"
}
